{
  "name": "jane-joe/livewire-secure-properties",
  "description": "Automatically lock Livewire properties from client-side modification unless explicitly unlocked with zero configs.",
  "keywords": [
    "laravel",
    "livewire",
    "livewire4",
    "livewire-4",
    "security",
    "secure",
    "lock-properties",
    "properties",
    "property"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Jane Joe",
      "email": "jane.joe@example.com"
    }
  ],
  "require": {
    "livewire/livewire": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "JaneJoe\\LivewireSecureProperties\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JaneJoe\\LivewireSecureProperties\\LivewireSecurePropertiesServiceProvider"
      ]
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com"
    }
  ]
}
