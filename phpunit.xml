<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://w3.org"
         xsi:noNamespaceSchemaLocation="https://phpunit.de"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheResult="false">
    <testsuites>
        <testsuite name="Feature">
            <directory suffix="src/Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="LIVEWIRE_SECURE_PROPERTIES_ENABLED" value="true"/>
    </php>
</phpunit>

